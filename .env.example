# Environment Configuration Template
# Copy this file to .env and fill in your values

# Application Settings
APP_NAME=sigmaxim-prospecter-v3
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Keys (NEVER commit the actual .env file)
# AI Service API Keys
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./data/prospecter.db
# For PostgreSQL: postgresql://user:password@localhost:5432/dbname
# For MySQL: mysql://user:password@localhost:3306/dbname

# Service URLs
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Feature Flags
ENABLE_AI_SCORING=true
ENABLE_AUTO_ENRICHMENT=true
ENABLE_ANALYTICS=true

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=60
API_TIMEOUT_SECONDS=30

# Caching
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# Security
SECRET_KEY=your_secret_key_here_change_in_production
ALLOWED_HOSTS=localhost,127.0.0.1

# External Services
# CRM Integration
CRM_API_URL=
CRM_API_KEY=

# Email Service
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@sigmaxim.com

# Monitoring & Analytics
SENTRY_DSN=
ANALYTICS_TRACKING_ID=

# File Storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=10
